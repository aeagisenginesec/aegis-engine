
variable "open_ports" {
  type    = list(number)
  default = [22, 80, 443]
}

resource "aws_security_group" "dynweb" {
  name        = "dynweb-sg"
  description = "ingress generated by dynamic blocks"

  dynamic "ingress" {
    for_each = var.open_ports
    content {
      description = "dynamic port ${ingress.value}"
      from_port   = ingress.value
      to_port     = ingress.value
      protocol    = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
    }
  }
}
