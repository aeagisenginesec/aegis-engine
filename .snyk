# Snyk policy — path exclusions for Snyk Code / IaC scans.
#
# Same rationale as .semgrepignore and the SonarCloud exclusions in
# .github/workflows/sonar.yml: this repository deliberately contains
# vulnerable fixtures (benchmark corpora, evaluation data, demo
# stacks, parser testdata). They are data the scanners are tested
# AGAINST, not code that ships. Product code is cmd/ and internal/
# (excluding testdata) and stays fully scanned.
version: v1.25.0
exclude:
  global:
    - benchmark
    - docs/audit
    - tests/demos
    - tests/fixtures
    - demo
    - internal/regression
    - "**/testdata"
