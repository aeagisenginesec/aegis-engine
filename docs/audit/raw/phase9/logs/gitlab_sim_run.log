              "name": "GCS bucket without access logging",
              "shortDescription": {
                "text": "GCS bucket without access logging"
              },
              "help": {
                "text": "google_storage_bucket with no logging block has no audit trail of object access.\n\nHow to fix:\nEnable audit logging. Turn on CloudTrail (multi-region, log file validation, KMS-encrypted bucket), VPC flow logs, and service access logs. Ship logs to a dedicated, MFA-delete-protected bucket in a security account."
              },
              "helpUri": "https://docs.aws.amazon.com/awscloudtrail/latest/userguide/cloudtrail-user-guide.html",
              "properties": {
                "severity": "medium"
