              "shortDescription": {
                "text": "Search domain outside VPC"
              },
              "help": {
                "text": "An Elasticsearch or OpenSearch domain without vpc_options is deployed with a public endpoint, exposing cluster APIs to the internet instead of keeping traffic inside the VPC.\n\nHow to fix:\nReview the flagged configuration against AWS security best practices and the CIS AWS Foundations Benchmark. Apply the control the rule describes, preferring restrictive defaults, encryption, and audit logging. Validate with `aegis scan` after the change."
              },
              "helpUri": "https://docs.aws.amazon.com/securityhub/latest/userguide/securityhub-standards.html",
              "properties": {
                "severity": "high"
