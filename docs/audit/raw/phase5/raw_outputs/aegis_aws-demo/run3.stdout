    {
      "rule_id": "AEGIS-AWS-790",
      "title": "SSM SecureString parameter using default KMS key",
      "description": "A SecureString parameter with no key_id encrypts with the default aws/ssm key, which the account cannot rotate or scope via key policy. Point key_id at a customer-managed key.",
      "severity": "low",
      "resource": "aws_ssm_parameter.demo",
      "evidence": {
        "attribute": "key_id",
        "span": {
          "file": "/home/hatch/workspace/aegis-engine/tests/demos/aws-security-demo/secure/26-ssm-plaintext.tf",
          "start_line": 1,
          "start_col": 1,
          "end_line": 5,
          "end_col": 2
        },
        "actual": "[REDACTED]",
        "expected": "key_id set to a customer-managed KMS key"
      },
      "remediation": "Enable encryption at rest. For AWS-managed keys add the service's encryption block (e.g. `storage_encrypted = true` for RDS, `server_side_encryption_configuration` for S3). For regulated data use a customer-managed KMS key via `kms_key_id` and enable key rotation.",
      "references": [
        "https://docs.aws.amazon.com/kms/latest/developerguide/concepts.html"
      ],
      "compliance": [
        {
          "framework": "NIST-800-53",
          "control": "SC-12"
        }
      ]
    },
