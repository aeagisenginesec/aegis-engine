      "description": "A Neptune cluster with skip_final_snapshot = true destroys all graph data on cluster deletion with no final backup, making accidental or malicious deletion unrecoverable. Keep skip_final_snapshot = false (the default) on production clusters.",
      "severity": "medium",
      "resource": "aws_neptune_cluster.np1",
      "evidence": {
        "attribute": "skip_final_snapshot",
        "span": {
          "file": "/home/hatch/workspace/terraform/vuln-200/main.tf",
          "start_line": 1064,
          "start_col": 25,
          "end_line": 1064,
          "end_col": 29
        },
        "actual": "true",
        "expected": "skip_final_snapshot = false"
      },
      "remediation": "Enable data protection. Turn on versioning / point-in-time recovery / automated backups with a retention period ≥ 7 days (30+ for production). Test restores regularly — untested backups are not backups.",
      "references": [
        "https://docs.aws.amazon.com/aws-backup/latest/devguide/whatisbackup.html"
      ],
      "compliance": [
        {
          "framework": "NIST-800-53",
          "control": "CP-9"
        }
      ]
