{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Customer DB. Encryption was enabled, but the instance was left publicly reachable for the BI tool.",
  "Parameters": {
    "MasterPassword": { "Type": "String", "NoEcho": true },
    "VpcId": { "Type": "String" }
  },
  "Resources": {
    "CustomerDbSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Customer database",
        "VpcId": { "Ref": "VpcId" },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "CustomerDb": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": "15.4",
        "DBInstanceClass": "db.t3.large",
        "AllocatedStorage": 100,
        "DBName": "customers",
        "MasterUsername": "dbadmin",
        "MasterUserPassword": { "Ref": "MasterPassword" },
        "StorageEncrypted": true,
        "PubliclyAccessible": true,
        "BackupRetentionPeriod": 7,
        "VPCSecurityGroups": [{ "Ref": "CustomerDbSg" }],
        "CopyTagsToSnapshot": true
      }
    }
  },
  "Outputs": {
    "Endpoint": { "Value": { "Fn::GetAtt": ["CustomerDb", "Endpoint.Address"] } }
  }
}
